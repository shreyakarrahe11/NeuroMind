# Docker Compose interpolation values. Copy to .env.production.compose and fill in real values.
# Keep this real file out of Git. Server-only application secrets also belong in backend/.env.production.
PUBLIC_ORIGIN=https://your-real-domain.example
POSTGRES_DB=neuromind
POSTGRES_USER=neuromind
POSTGRES_PASSWORD=replace-with-a-unique-database-password
MINIO_ROOT_USER=replace-with-a-unique-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-unique-minio-password
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_your_clerk_publishable_key
WEB_PORT=80
API_WORKERS=2
AI_WORKER_CONCURRENCY=1

# The model bundle must be a ZIP containing speech/ and multimodal/ at its root.
# Use a stable HTTPS download endpoint. A private object store/Hugging Face endpoint may use a bearer token.
MODEL_BUNDLE_URL=https://replace-with-a-direct-https-model-bundle-download-url
MODEL_BUNDLE_SHA256=replace-with-the-64-character-sha256-of-the-zip
MODEL_BUNDLE_BEARER_TOKEN=
