APP_NAME=NeuroMind API
ENVIRONMENT=production
DEBUG=false
API_DOCS_ENABLED=false
AUTH_RETURN_TOKENS=false
JWT_SECRET_KEY=generate-a-unique-random-secret-at-least-32-characters
DATA_ENCRYPTION_KEY=generate-a-unique-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TASK_QUEUE_MODE=celery
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
TASK_SOFT_TIME_LIMIT_SECONDS=900
TASK_TIME_LIMIT_SECONDS=1200

CLERK_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_JWT_KEY=
CLERK_SECRET_KEY=replace-with-clerk-server-secret-key
CLERK_AUTHORIZED_PARTIES=https://your-domain.example

INITIAL_ADMIN_EMAIL=admin@your-domain.example
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password
AUTO_CREATE_INITIAL_ADMIN=true

STORAGE_PATH=/app/storage
STORAGE_BACKEND=s3
S3_BUCKET=neuromind
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=replace-with-minio-or-cloud-access-key
S3_SECRET_ACCESS_KEY=replace-with-minio-or-cloud-secret-key
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=
KNOWLEDGE_BASE_PATH=/app/knowledge_base
CHROMA_PATH=/app/chroma_db
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
VECTOR_DB_TYPE=chroma
MAX_UPLOAD_MB=25

SPEECH_MODEL_PATH=/app/ai_models/speech/neuromind_speech_bilstm_attention.pt
MULTIMODAL_MODEL_PATH=/app/ai_models/multimodal/neuromind_multimodal_transformer_binary.pt
WAV2VEC_MODEL_NAME=/app/ai_models/speech/wav2vec2_backbone
WAV2VEC_LOCAL_FILES_ONLY=true
MODEL_DEVICE=cpu

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REQUIRE_RAG_EVIDENCE_FOR_REPORT=true
REQUIRE_MODELS_FOR_READINESS=true

# Model bundle URL/hash/token are Compose interpolation values, not application settings.
# Configure them in the root .env.production.compose file; see MODEL_INTEGRATION_GUIDE.md.
