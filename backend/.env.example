APP_NAME=NeuroMind API
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/neuromind
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
JWT_SECRET_KEY=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=generate-a-fernet-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RETURN_TOKENS=true
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
STORAGE_PATH=./storage
KNOWLEDGE_BASE_PATH=../knowledge_base
MAX_UPLOAD_MB=25

# Clerk PATIENT authentication
# Recommended: use the Frontend API host shown in the Clerk dashboard.
# The API verifies rotating Clerk keys from <issuer>/.well-known/jwks.json.
CLERK_JWT_KEY=
# Server-only Clerk key from Dashboard -> API keys. Never expose it as VITE_*.
CLERK_SECRET_KEY=
CLERK_ISSUER=https://noble-drake-90.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:5173

# Initial local ADMIN bootstrap
INITIAL_ADMIN_EMAIL=admin@neuromind.local
INITIAL_ADMIN_PASSWORD=generate-a-unique-strong-password
AUTO_CREATE_INITIAL_ADMIN=true
API_DOCS_ENABLED=true

SPEECH_MODEL_PATH=
MEMORY_MODEL_PATH=
ATTENTION_MODEL_PATH=
LIFESTYLE_MODEL_PATH=
MULTIMODAL_MODEL_PATH=
REPORT_MODEL_PATH=
WAV2VEC_MODEL_NAME=facebook/wav2vec2-base-960h
WAV2VEC_LOCAL_FILES_ONLY=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REQUIRE_RAG_EVIDENCE_FOR_REPORT=true
VECTOR_DB_TYPE=chroma
CHROMA_PATH=./chroma_db
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
MODEL_DEVICE=cpu
MODEL_LOAD_ON_STARTUP=false
