{
  "name": "neuromind-combined-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:ai": "node scripts/backend-task.mjs ai-install",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "dev:frontend": "node node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "dev:backend": "node scripts/backend-task.mjs serve",
    "db:migrate": "node scripts/backend-task.mjs migrate",
    "db:admin": "node scripts/backend-task.mjs admin",
    "doctor": "node scripts/doctor.mjs",
    "models:status": "node scripts/backend-task.mjs models",
    "preflight": "node scripts/backend-task.mjs preflight",
    "test:backend": "node scripts/backend-task.mjs test",
    "test:auth": "node scripts/backend-task.mjs auth-test",
    "check": "npm run lint && node scripts/backend-task.mjs check",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "node scripts/clean.mjs",
    "lint": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@clerk/react": "^6.14.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
